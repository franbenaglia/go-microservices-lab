# Copiar a .env y cambiar los valores. .env no se versiona.
# Credenciales locales del laboratorio (nunca se guardan en Consul KV).
POSTGRES_PASSWORD=change-me-postgres
INVENTORY_DB_PASSWORD=change-me-inventory
ORDERS_DB_PASSWORD=change-me-orders

# Puerto de PostgreSQL publicado solo en 127.0.0.1 (pruebas de integración).
PG_HOST_PORT=55432
