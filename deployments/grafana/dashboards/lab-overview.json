    "list": [
      {
        "name": "Cambios del circuit breaker",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "sum(changes(circuit_breaker_state[20s])) > 0",
        "step": "5s",
        "titleFormat": "Circuit breaker",
        "textFormat": "cambio de estado"
      }
    ]
  },
  "links": [
    {
